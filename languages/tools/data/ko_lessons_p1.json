    "sections": [
      {
        "p": "<b>일, 이, 삼, 사, 오, 육, 칠, 팔, 구, 십</b> are the Sino-Korean digits. They combine for larger numbers: 십일 eleven, 이십 twenty, 삼십오 thirty-five.",
        "examples": [
          [
            "오월",
            "owol",
            "May (month five)"
          ],
          [
            "삼천 원",
            "samcheon won",
            "three thousand won"
          ],
          [
            "이층",
            "icheung",
            "second floor"
          ]
        ]
      }
    ],
