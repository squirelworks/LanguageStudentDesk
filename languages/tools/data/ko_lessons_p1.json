  {
    "id": "hangul-greetings",
    "level": "absolute-beginner",
    "title": "Greetings",
    "particle": "안녕하세요",
    "summary": "Hello, goodbye and thank you in polite speech.",
    "sections": [
      {
        "p": "<b>안녕하세요</b> is hello. <b>안녕히 가세요</b> says goodbye to someone leaving; <b>안녕히 계세요</b> to someone staying. <b>감사합니다</b> is thank you; <b>천만에요</b> answers it.",
        "examples": [
          [
            "{안녕하세요}.",
            "annyeonghaseyo.",
            "Hello."
          ],
          [
            "{감사합니다}.",
            "gamsahamnida.",
            "Thank you."
          ],
          [
            "{안녕히} 가세요.",
            "annyeonghi gaseyo.",
            "Goodbye (you are going)."
          ]
        ]
      }
    ],
    "drills": [
      {
        "q": "Polite hello is…",
        "en": "",
        "options": [
          "안녕하세요",
          "안녕",
          "감사합니다",
          "죄송합니다"
        ],
        "answer": "안녕하세요",
        "why": "안녕하세요 is the everyday polite hello."
      },
      {
        "q": "You thank someone with…",
        "en": "",
        "options": [
          "감사합니다",
          "미안합니다",
          "안녕히 계세요",
          "네"
        ],
        "answer": "감사합니다",
        "why": "감사합니다 is thank you."
      },
      {
        "q": "Someone leaves your shop. You say…",
        "en": "",
        "options": [
          "안녕히 가세요",
          "안녕히 계세요",
          "안녕하세요",
          "들어오세요"
        ],
        "answer": "안녕히 가세요",
        "why": "They go, so 가세요."
      },
      {
        "q": "You stay; the guest leaves. They say to you…",
        "en": "",
        "options": [
          "안녕히 계세요",
          "안녕히 가세요",
          "감사합니다",
          "안녕"
        ],
        "answer": "안녕히 계세요",
        "why": "You stay: 계세요."
      },
      {
        "q": "Answer to 감사합니다 is often…",
        "en": "",
        "options": [
          "천만에요",
          "안녕하세요",
          "네",
          "아니요"
        ],
        "answer": "천만에요",
        "why": "천만에요 or 아니에요: you're welcome."
      }
    ]
  },
  {
    "id": "hangul-ne-aniyo",
    "level": "absolute-beginner",
    "title": "Yes and no",
    "particle": "네 / 아니요",
    "summary": "Short answers in polite conversation.",
    "sections": [
      {
        "p": "<b>네</b> (often pronounced ne or e) means yes. <b>아니요</b> means no. <b>아니에요</b> softens “that's not so” or “I'm not”.",
        "examples": [
          [
            "{네}, 맞아요.",
            "Ne, majayo.",
            "Yes, that's right."
          ],
          [
            "{아니요}, 괜찮아요.",
            "Aniyo, gwaenchanayo.",
            "No, it's fine."
          ],
          [
            "저는 학생이 {아니에요}.",
            "Jeoneun haksaeng-i anieyo.",
            "I'm not a student."
          ]
        ]
      }
    ],
    "drills": [
      {
        "q": "Polite yes is…",
        "en": "",
        "options": [
          "네",
          "예",
          "아니요",
          "네요"
        ],
        "answer": "네",
        "why": "네 is yes in everyday polite speech."
