  {
    "id": "do-particle",
    "level": "beginner",
    "title": "도 — also, too",
    "particle": "도",
    "summary": "Adds “also” or “even” after a noun.",
    "sections": [
      {
        "p": "<b>도</b> after a noun means also, too, or even. It replaces 은/는 or 을/를 when those roles apply: 저도 “me too”, 커피도 “coffee too”.",
        "examples": [
          [
            "저{도} 학생이에요.",
            "Jeodo haksaeng-ieyo.",
            "I'm a student too."
          ],
          [
            "물{도} 마셔요.",
            "Mul-do masyeoyo.",
            "I drink water too."
          ]
        ]
      }
    ],
    "drills": [
      {
        "q": "I like coffee too: 커피＿.",
        "en": "",
        "options": [
          "도",
          "는",
          "만",
