    {
      "id": "yennayer",
      "topic": "culture",
      "title": "Yennayer",
      "body": [
        "Yennayer is the Amazigh new year, celebrated around 13 January across North Africa with family meals, often a couscous or a dish with seven vegetables. The Amazigh calendar counts its years from 950 BC, so 2026 is around 2976.",
        "Morocco made Yennayer a national public holiday in 2023, and Algeria did so in 2018."
      ],
      "tags": [
        "festivals",
        "calendar"
      ]
    },
    {
      "id": "copula-d",
      "topic": "verbs",
      "title": "ⴷ — “is”",
      "body": "To say “I am a …”, put ⴷ (d) between the pronoun and the noun: ⵏⴽⴽ ⴷ ⴰⵏⵍⵎⴰⴷ “I am a student”. The same ⴷ links other persons to what they are.",
      "examples": [
        {
          "t": "{ⵏⴽⴽ} ⴷ ⴰⵏⵍⵎⴰⴷ.",
          "r": "Nkk d anlmad.",
          "e": "I am a student."
        },
        {
          "t": "ⵏⵜⵜⴰⵜ {ⴷ} ⵜⴰⵙⵍⵎⴰⴷⵜ.",
          "r": "Nttat d taslmadt.",
          "e": "She is a teacher."
        },
        {
          "t": "{ⵏⴽⵏⵉ} ⴷ ⵉⵎⴰⵣⵉⵖⵏ.",
          "r": "Nkni d imaziɣn.",
          "e": "We are Amazigh."
        }
      ],
      "tags": [
        "copula"
      ]
    },
    {
      "id": "prepositions",
      "topic": "grammar",
      "title": "In, from, to",
      "body": "Short prepositions sit before the place word: ⴳ (g) “in / at”, ⵣⴳ (zg) “from”, ⵙ (s) “to / toward”.",
      "examples": [
        {
          "t": "ⵏⴽⴽ {ⵣⴳ} ⵎⵔⵔⴰⴽⵛ.",
          "r": "Nkk zg Mrrakc.",
          "e": "I'm from Marrakech."
        },
        {
          "t": "ⵜⵣⴷⵖ {ⴳ} ⵕⴱⴰⵟ.",
          "r": "Tzdɣ g Rbaṭ.",
          "e": "She lives in Rabat."
        },
        {
          "t": "ⴷⴷⵉⵖ {ⵙ} ⵜⵉⵣⵏⵉⵜ.",
          "r": "Ddiɣ s Tiznit.",
          "e": "I went to Tiznit."
        },
        {
          "t": "ⵏⴽⴽ {ⴳ} ⵜⴷⴷⴰⵔⵜ.",
          "r": "Nkk g tddart.",
          "e": "I'm at home."
        }
      ],
      "tags": [
        "prepositions"
      ]
    },
    {
      "id": "verbs-negation",
      "topic": "verbs",
      "title": "Did, want, and ⵓⵔ “not”",
      "body": "A past form already shows the person: ⴷⴷⵉⵖ (ddiɣ) “I went”, ⵔⵉⵖ (riɣ) “I want”. Negation puts ⵓⵔ (ur) before the verb: ⵓⵔ ⵙⵙⵉⵏⵖ (ur ssinɣ) “I don’t know”.",
      "examples": [
        {
          "t": "ⵉⴹⵍⵍⵉ {ⴷⴷⵉⵖ} ⵙ ⵎⵔⵔⴰⴽⵛ.",
          "r": "Iḍlli ddiɣ s Mrrakc.",
          "e": "Yesterday I went to Marrakech."
        },
        {
          "t": "{ⵔⵉⵖ} ⴰⵎⴰⵏ.",
          "r": "Riɣ aman.",
          "e": "I want water."
        },
        {
          "t": "{ⵓⵔ} ⵙⵙⵉⵏⵖ.",
          "r": "Ur ssinɣ.",
          "e": "I don't know."
        }
      ],
      "tags": [
        "verbs",
        "negation"
      ]
    }
  ]
}
