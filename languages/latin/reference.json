    {
      "id": "perfect",
      "topic": "verbs",
      "title": "Perfect tense: amāvī",
      "body": "The perfect is a single completed action: I loved, I have loved. Take the third principal part and use the special perfect endings, which are the same for every verb.",
      "table": {
        "head": [
          "Person",
          "Ending",
          "amō",
          "sum"
        ],
        "rows": [
