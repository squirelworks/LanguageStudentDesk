          ["ನೀವು you (polite)", "-ಈರಿ", "ಮಾಡುತ್ತೀರಿ"],
          ["ಅವನು he", "-ಆನೆ", "ಮಾಡುತ್ತಾನೆ"],
          ["ಅವಳು she", "-ಆಳೆ", "ಮಾಡುತ್ತಾಳೆ"],
