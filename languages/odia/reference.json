    {
      "id": "phrases",
      "topic": "phrases",
      "title": "Everyday phrases",
      "examples": [
        {
          "t": "ନମସ୍କାର, ଆପଣ କେମିତି ଅଛନ୍ତି?",
          "r": "Namaskaara, apana kemiti achhanti?",
          "e": "Hello, how are you?"
        },
        {
          "t": "ମୁଁ ଭଲ ଅଛି, ଧନ୍ୟବାଦ।",
          "r": "Mun bhala achhi, dhanyabaada.",
          "e": "I'm fine, thank you."
        },
        {
          "t": "ମୁଁ ବୁଝେ ନାହିଁ।",
          "r": "Mun bujhe naahin.",
          "e": "I don't understand."
        },
        {
          "t": "ଏହାର ଦାମ କେତେ?",
          "r": "Ehaara daama kete?",
          "e": "How much is this?"
        },
        {
          "t": "ଧୀରେ କହନ୍ତୁ।",
          "r": "Dhiire kahantu.",
          "e": "Please speak slowly."
