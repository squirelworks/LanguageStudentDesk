    {
      "id": "past",
      "topic": "verbs",
      "title": "The past tense",
      "body": "Past forms add a past marker to the stem. For ଯିବା (jibā) “to go”, a common past is ଗଲି (gali) “I went” / ଗଲା (galā) “he went”, with endings that show the subject.",
      "examples": [
        {
          "t": "ମୁଁ ଘରକୁ {ଗଲି}.",
          "r": "Mũ gharaku gali.",
          "e": "I went home."
        },
        {
          "t": "ସେ ବଜାରକୁ {ଗଲା}.",
          "r": "Se bajāraku galā.",
          "e": "He went to the market."
        }
      ],
      "tags": [
        "past"
      ]
